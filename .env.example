# Supabase — Project Settings → API
NUXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave publicable (antes "anon key"). Se envía al navegador: es segura porque
# la RLS decide qué filas puede leer cada usuario.
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Secret key (antes "service_role"). SÓLO servidor: salta la RLS por completo.
# No la expongas nunca con el prefijo NUXT_PUBLIC_.
NUXT_SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
